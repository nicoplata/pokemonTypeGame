{
  "name": "pokemon-type-game",
  "version": "2.0.0",
  "private": true,
  "description": "Juego de combate Pokémon por turnos en el navegador.",
  "type": "module",
  "scripts": {
    "start": "node scripts/servidor.mjs",
    "datos": "node scripts/generar-datos.mjs",
    "build:css": "sass --no-source-map sass/styles.scss styles/styles.css",
    "check:css": "npm run build:css && git diff --exit-code -- styles/styles.css",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "sass": "1.107.1",
    "vitest": "5.1.0"
  }
}
